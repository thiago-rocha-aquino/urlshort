# Aplicacao
APP_NAME=api_url_shortener
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001
APP_BASE_URL=http://localhost:8001

# Banco de dados (porta 5433 para nao colidir com o Postgres do projeto 1)
DATABASE_URL=postgresql+asyncpg://urlshort:urlshort@localhost:5433/urlshort

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=urlshort:click_events
REDIS_CONSUMER_GROUP=urlshort-workers

# JWT
JWT_SECRET_KEY=troque-isto-em-producao-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Slugs
SLUG_LENGTH=7

# GeoIP (opcional; se vazio, geolocalizacao fica desabilitada)
GEOIP_DATABASE_PATH=

# Rate limit
RATE_LIMIT_CREATE_PER_MINUTE=20
